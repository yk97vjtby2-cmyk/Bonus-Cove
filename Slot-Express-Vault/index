        ...trafficContext,
        ...eventDetails
      };

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(eventData);
      window.dispatchEvent(new CustomEvent("vaultTrackingEvent", { detail: eventData }));
    }

    const escapeHTML = (value) => String(value).replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    })[character]);

    function closeVaults() {
      vaultCards.forEach((card) => card.classList.remove("open"));
      vaultButtons.forEach((button) => button.setAttribute("aria-expanded", "false"));
      result.classList.remove("visible");
      result.replaceChildren();
    }

    function resetVaults(message = "All vaults are unlocked. Choose one below.") {
      vaultButtons.forEach((button) => { button.disabled = false; });
      vaultCards.forEach((card) => {
        card.querySelector(".open-label").textContent = "Open this vault";
      });
      closeVaults();
      status.className = "status success";
      status.textContent = message;
    }

    function updateLocationInfo() {
      const region = regions[province.value];
      unlockedRegion = province.value;

      if (region) {
        const telephone = region.supportPhone.replace(/[^\d+]/g, "");
        locationDetails.textContent = `${region.name}: legal gambling age ${region.age}+. Check that the operator is permitted or appropriately authorized for this location.`;
        supportCopy.textContent = `Help in ${region.name}: ${region.supportName}. Free or confidential support may be available. Set limits, never chase losses and stop if gambling is causing harm.`;
        supportActions.innerHTML = `
          <a class="support-link primary" href="tel:${escapeHTML(telephone)}">Call ${escapeHTML(region.supportPhone)}</a>
          <a class="support-link" href="${escapeHTML(region.supportUrl)}" target="_blank" rel="noopener">Local support website</a>
        `;
        trackEvent("location_selected", { region: unlockedRegion });
      } else {
        locationDetails.textContent = "Canada: legal gambling age and licensing rules vary by location.";
        supportCopy.textContent = "Set a spending limit, never chase losses and take regular breaks. Select your location to see the appropriate local support service.";
        supportActions.innerHTML = `
          <a class="support-link" href="https://responsiblegambling.org/for-the-public/problem-gambling-help/help-for-canadians/" target="_blank" rel="noopener">Canada support directory</a>
        `;
      }

      try {
        if (unlockedRegion) {
          localStorage.setItem("canadaVaultRegion", unlockedRegion);
        } else {
          localStorage.removeItem("canadaVaultRegion");
        }
      } catch (error) {
        // The experience still works if browser storage is unavailable.
      }

      resetVaults(region
        ? `Location information updated for ${region.name}. All vaults are unlocked.`
        : "All vaults are unlocked. Choose one below."
      );
    }

    function buildAffiliateUrl(offer, vaultId) {
      const clickReference = trafficContext.clickId || "landing-page";
      const subReference = trafficContext.creative || trafficContext.zoneId || vaultId;
      return offer.affiliateUrl
        .replace("addclickidhere", encodeURIComponent(clickReference))
        .replace("addsubidhere", encodeURIComponent(subReference));
    }

    function showOffer(region, vaultId) {
      const offer = affiliateOffers[vaultId];
      if (!offer) return;
      activeOffer = offer;
      activeVault = vaultId;

      const hasLink = /^https?:\/\//i.test(offer.affiliateUrl);
      const isApproved = !unlockedRegion || offer.approvedRegions.includes(unlockedRegion);
      const isConfigured = hasLink && isApproved;

      if (isConfigured) {
        offerLink.href = buildAffiliateUrl(offer, vaultId);
        offerLink.removeAttribute("aria-disabled");
        offerLink.setAttribute("aria-label", "Claim Slot Express welcome offer");
      } else {
        offerLink.href = "#";
        offerLink.setAttribute("aria-disabled", "true");
        offerLink.setAttribute("aria-label", "Slot Express offer unavailable in the selected location");
      }

      offerModal.classList.add("show");
      offerModal.setAttribute("aria-hidden", "false");
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
    }

    function closeOfferModal() {
      offerModal.classList.remove("show");
      offerModal.setAttribute("aria-hidden", "true");
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
    }

    function openVault(card) {
      const region = regions[unlockedRegion] || { name: "Canada" };
      const vaultId = card.dataset.vault;
      closeVaults();
      card.classList.add("open");
      const selectedButton = card.querySelector(".vault-button");
      selectedButton.setAttribute("aria-expanded", "true");

      vaultCards.forEach((vaultCard) => {
        const button = vaultCard.querySelector(".vault-button");
        const label = vaultCard.querySelector(".open-label");
        const isSelected = vaultCard === card;
        button.disabled = false;
        label.textContent = isSelected ? "Selected vault" : "Open this vault";
      });

      status.className = "status";
      status.textContent = "";
      trackEvent("vault_opened", {
        region: unlockedRegion || "not_selected",
        vault: vaultId,
        operator: affiliateOffers[vaultId].operatorName
      });

      window.setTimeout(() => {
        showOffer(region, vaultId);
        trackEvent("offer_viewed", {
          region: unlockedRegion || "not_selected",
          vault: vaultId,
          operator: affiliateOffers[vaultId].operatorName
        });
      }, 480);
    }

    province.addEventListener("change", updateLocationInfo);
    gate.addEventListener("submit", (event) => event.preventDefault());

    vaultCards.forEach((card) => {
      card.querySelector(".vault-button").addEventListener("click", () => openVault(card));
    });

    offerLink.addEventListener("click", (event) => {
      if (offerLink.getAttribute("aria-disabled") === "true") {
        event.preventDefault();
        return;
      }

      trackEvent("affiliate_click", {
        region: unlockedRegion || "not_selected",
        vault: activeVault,
        operator: activeOffer ? activeOffer.operatorName : "unknown"
      });
    });
    offerClose.addEventListener("click", closeOfferModal);

    offerModal.addEventListener("click", (event) => {
      if (event.target === offerModal) closeOfferModal();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && offerModal.classList.contains("show")) {
        closeOfferModal();
      }
    });

try {
      const savedRegion = localStorage.getItem("canadaVaultRegion");
      if (savedRegion && regions[savedRegion]) {
        province.value = savedRegion;
        updateLocationInfo();
      }
    } catch (error) {
      // No action is required when storage is blocked.
    }

    trackEvent("landing_view");
  </script>
</body>
</html>
